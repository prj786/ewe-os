#!/bin/bash
# ewe-install-helper — the ONLY privileged surface of ewe-installer.
#
# polkit authorises this PATH, so the case statement below is the entire
# definition of what the installer may do as root (the Komble helper
# pattern). Every verb validates its arguments, prints JSON progress lines
# ({"phase":..,"msg":..} / {"pct":N}) on stdout, and is individually
# idempotent enough to re-run after a failure. The TUI path (ewe-install)
# drives these same verbs — one implementation, two faces.
#
# Destructive verbs (partition/mkfs) demand the literal confirmation token
# ERASE=<disk> as their last argument — a UI bug can never wipe a disk with
# a bare call.
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

MNT=/mnt/ewe-install
# Every download runs with pacman's relaxed timeouts. By default libalpm gives
# up on a transfer that moves less than 1 byte/s for 10 s ("Operation too
# slow") — one stalled mirror or GitHub asset then fails the verb, and Retry
# starts the whole install over from an empty disk. A stall that passes costs
# only its own seconds this way (pacman 7.1, a 40 s stall mid-package: exit 1
# after 17 s without the flag, installed with it). The price: a connection
# that has died for good is noticed by TCP's own timeouts, later than 10 s.
# pacstrap hands everything after the root to pacman, so the flag rides along
# there too.
NO_STALL=--disable-download-timeout

die() { printf '{"error":%s}\n' "$(printf '%s' "$*" | python3 -c 'import json,sys;print(json.dumps(sys.stdin.read()))')" >&2; exit 1; }
say() { printf '{"phase":"%s","msg":"%s"}\n' "$1" "$2"; }

valid_disk() { [[ "$1" =~ ^/dev/(sd[a-z]+|nvme[0-9]+n[0-9]+|vd[a-z]+|mmcblk[0-9]+)$ ]] && [ -b "$1" ]; }
part_of() {  # disk, index -> partition node (nvme/mmc need the p)
    case "$1" in *[0-9]) echo "$1p$2" ;; *) echo "$1$2" ;; esac
}
valid_user() { [[ "$1" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; }
# glibc locale names as SUPPORTED lists them: en_US.UTF-8, sr_RS.UTF-8@latin, aa_ER
valid_locale() { [[ "$1" =~ ^[A-Za-z0-9_.@-]{2,64}$ ]]; }
# xkb layout/variant lists, parallel and comma-joined; variants may be empty
valid_layouts() {
    [[ "$1" =~ ^[a-z0-9_]{1,32}(,[a-z0-9_]{1,32}){0,3}$ ]] || return 1
    [ -z "$2" ] && return 0
    [[ "$2" =~ ^[A-Za-z0-9_-]*(,[A-Za-z0-9_-]*){0,3}$ ]] || return 1
    local a b
    a="${1//[^,]/}"; b="${2//[^,]/}"
    [ "${#a}" = "${#b}" ]
}
# package names as Arch allows them
valid_pkg() { [[ "$1" =~ ^[a-z0-9@_+][a-z0-9@._+-]{0,99}$ ]]; }
# what the language verb may install: spelling dictionaries and fcitx5 (+ its
# engines and toolkit glue) — the families ewe Settings installs on demand
valid_lang_pkg() { [[ "$1" =~ ^(hunspell-[a-z0-9_-]+|fcitx5(-[a-z0-9_-]+)?)$ ]]; }

# xkb layouts whose first level is not Latin (the installer's NON_LATIN list):
# the console starts with the first layout NOT in here
NON_LATIN=" ru ua by bg mk rs kz kg mn tj uz ge am gr il ara iq sy ir af pk ma in bd np lk th la kh mm et er bt mv eg "

# console_keymap <layouts> <variants> → a kbd keymap name present on the target
console_keymap() {
    local -a ls vs
    local i l v km map="$MNT/usr/share/systemd/kbd-model-map"
    IFS=',' read -ra ls <<< "$1"
    IFS=',' read -ra vs <<< "${2:-}"
    for i in "${!ls[@]}"; do
        l="${ls[$i]}"; v="${vs[$i]:-}"
        case "$NON_LATIN" in *" $l "*) continue ;; esac
        km=""
        if [ -r "$map" ]; then
            # consolelayout xlayout xmodel xvariant …: the row whose first X
            # layout is ours, with our variant ("-" = none) — the first such row
            km="$(awk -v l="$l" -v v="${v:--}" '!/^#/ && NF >= 4 {
                    split($2, xl, ","); split($4, xv, ",")
                    if (xl[1] == l && (xv[1] == v || (v == "-" && $4 == "-"))) { print $1; exit } }' "$map")"
        fi
        [ -n "$km" ] || km="$l"
        if [ -n "$(find "$MNT/usr/share/kbd/keymaps" -name "$km.map.gz" -print -quit 2>/dev/null)" ]; then
            printf '%s\n' "$km"; return 0
        fi
    done
    printf 'us\n'
}

# base_packages <root fstype> → what pacstrap installs, one name per line.
#   sudo         the `user` verb makes the first account an administrator
#                through /etc/sudoers.d/wheel, and base has no sudo — GUI
#                installs shipped without it until the 0.17 QEMU pass found
#                "command not found: sudo"
#   dosfstools   fsck.vfat for the ESP, which fstab asks systemd to check
#   btrfs-progs  on btrfs (what the installer makes): the `btrfs` tool itself
#                — subvolumes, snapshots, scrub — and fsck.btrfs. Without the
#                latter mkinitcpio's fsck hook counts an error on EVERY
#                initramfs build ("errors were encountered during the build",
#                and pacman's "error: command failed to execute correctly"):
#                in the install log, and at every kernel update afterwards
#                (0.18; measured on a btrfs root without it — the build
#                exits 1 without fsck.btrfs, 0 with it)
base_packages() {
    printf '%s\n' base linux linux-firmware sudo dosfstools
    case "${1:-}" in btrfs) printf '%s\n' btrfs-progs ;; esac
}

# tests source the functions above (`EWE_HELPER_LIB=1 . ewe-install-helper`,
# tests/helper-test.sh); pkexec clears the environment, so a real run never
# takes this branch
# shellcheck disable=SC2317  # exit for a direct run, return for a source
if [ "${EWE_HELPER_LIB:-}" = 1 ]; then return 0 2>/dev/null || exit 0; fi

[ "$(id -u)" -eq 0 ] || die "must run as root"
[ $# -ge 1 ] || die "no verb"
verb="$1"; shift

case "$verb" in

# ── probe (read-only; the UI may call freely) ────────────────────────────────
probe)
    lsblk -J -d -o NAME,PATH,SIZE,MODEL,TYPE,RM,TRAN | python3 -c '
import json,sys
d=json.load(sys.stdin)
disks=[b for b in d["blockdevices"] if b["type"]=="disk" and not b["rm"] and not b["name"].startswith("zram")]
print(json.dumps({"disks":disks,
                  "battery": __import__("glob").glob("/sys/class/power_supply/BAT*") != [],
                  "ram_gb": round(__import__("os").sysconf("SC_PAGE_SIZE")*__import__("os").sysconf("SC_PHYS_PAGES")/2**30)}))'
    ;;

# ── partition <disk> <fs:btrfs|ext4> ERASE=<disk> ───────────────────────────
partition)
    disk="$1"; fs="$2"; confirm="${3:-}"
    valid_disk "$disk" || die "not a whole disk: $disk"
    [ "$confirm" = "ERASE=$disk" ] || die "missing erase confirmation"
    [ "$fs" = btrfs ] || [ "$fs" = ext4 ] || die "fs must be btrfs or ext4"
    say partition "wiping $disk"
    umount -R "$MNT" 2>/dev/null || true
    wipefs -af "$disk" >/dev/null
    say partition "GPT: 1G ESP + root"
    parted -s "$disk" mklabel gpt \
        mkpart ESP fat32 1MiB 1025MiB set 1 esp on \
        mkpart root "$fs" 1025MiB 100%
    udevadm settle
    say partition "done"
    ;;

# ── mkfs <disk> <fs> ERASE=<disk> ───────────────────────────────────────────
mkfs)
    disk="$1"; fs="$2"; confirm="${3:-}"
    valid_disk "$disk" || die "not a whole disk: $disk"
    [ "$confirm" = "ERASE=$disk" ] || die "missing erase confirmation"
    esp="$(part_of "$disk" 1)"; root="$(part_of "$disk" 2)"
    say mkfs "ESP: vfat"
    mkfs.fat -F32 "$esp" >/dev/null
    if [ "$fs" = btrfs ]; then
        say mkfs "root: btrfs + @ /@home subvolumes (zstd)"
        mkfs.btrfs -fq "$root"
        mount "$root" "$MNT" --mkdir
        btrfs -q subvolume create "$MNT/@"
        btrfs -q subvolume create "$MNT/@home"
        umount "$MNT"
        mount -o subvol=@,compress=zstd:1,noatime "$root" "$MNT" --mkdir
        mount -o subvol=@home,compress=zstd:1,noatime "$root" "$MNT/home" --mkdir
    else
        say mkfs "root: ext4"
        mkfs.ext4 -Fq "$root"
        mount "$root" "$MNT" --mkdir
    fi
    mount "$esp" "$MNT/boot" --mkdir
    say mkfs "mounted at $MNT"
    ;;

# ── pacstrap ─────────────────────────────────────────────────────────────────
pacstrap)
    mountpoint -q "$MNT" || die "target not mounted"
    say pacstrap "installing the base system (this is the long one)"
    mapfile -t base < <(base_packages "$(findmnt -n -o FSTYPE "$MNT")")
    # The console keymap file, before the first initramfs is built in there:
    # without one mkinitcpio's sd-vconsole hook puts a warning in the middle
    # of the log. `setkeymap` writes the chosen keyboard into the same file
    # right after; no package owns it.
    [ -s "$MNT/etc/vconsole.conf" ] \
        || { install -d "$MNT/etc" && printf 'KEYMAP=us\n' > "$MNT/etc/vconsole.conf"; }
    # `if !` keeps errexit from killing us silently: the error line below is
    # what the installer shows (stdout is the progress stream; stderr is
    # read too, but this one must reach the log).
    if ! pacstrap "$MNT" "${base[@]}" "$NO_STALL" 2>&1 | while IFS= read -r l; do
        printf '{"phase":"pacstrap","log":%s}\n' "$(printf '%s' "$l" | python3 -c 'import json,sys;print(json.dumps(sys.stdin.read()[:160]))')"
    done; then
        printf '{"phase":"pacstrap","msg":"pacstrap failed — the base system could not be downloaded; check the connection and retry"}\n'
        die "pacstrap failed — the base system could not be downloaded; check the connection and retry"
    fi
    genfstab -U "$MNT" >> "$MNT/etc/fstab"
    say pacstrap "base installed, fstab written"
    ;;

# ── hibernate <fs> — phase-32's swapfile + resume wiring, ported ────────────
hibernate)
    fs="$1"
    mountpoint -q "$MNT" || die "target not mounted"
    ram_kb=$(awk '/MemTotal/{print $2}' /proc/meminfo)
    size_mb=$(( ram_kb / 1024 + 2048 ))
    say hibernate "swapfile ${size_mb}MB (RAM+2G)"
    if [ "$fs" = btrfs ]; then
        btrfs -q filesystem mkswapfile --size "${size_mb}m" "$MNT/swapfile"
    else
        mkswap -q --file "$MNT/swapfile" --size "${size_mb}M" 2>/dev/null || {
            dd if=/dev/zero of="$MNT/swapfile" bs=1M count="$size_mb" status=none
            chmod 600 "$MNT/swapfile"; mkswap -q "$MNT/swapfile"
        }
    fi
    printf '/swapfile none swap defaults 0 0\n' >> "$MNT/etc/fstab"
    root_src=$(findmnt -n -o SOURCE "$MNT")
    resume_uuid=$(blkid -s UUID -o value "${root_src%%[*}")
    if [ "$fs" = btrfs ]; then
        offset=$(btrfs inspect-internal map-swapfile -r "$MNT/swapfile")
        extra="resume=UUID=$resume_uuid resume_offset=$offset"
    else
        offset=$(filefrag -v "$MNT/swapfile" | awk 'NR==4{gsub(/\./,"",$4); print $4}')
        extra="resume=UUID=$resume_uuid resume_offset=$offset"
    fi
    mkdir -p "$MNT/etc/ewe"
    printf '%s\n' "$extra" > "$MNT/etc/ewe/resume-args"
    say hibernate "resume args staged: $extra"
    ;;

# ── bootloader ──────────────────────────────────────────────────────────────
bootloader)
    mountpoint -q "$MNT/boot" || die "ESP not mounted"
    say bootloader "systemd-boot"
    arch-chroot "$MNT" bootctl install >/dev/null
    root_src=$(findmnt -n -o SOURCE "$MNT")
    root_uuid=$(blkid -s UUID -o value "${root_src%%[*}")
    # phase 35's full quiet set + splash: kernel warnings stay below the ewe
    # plymouth splash, no [ OK ] lines, no blinking cursor — Ubuntu-grade.
    quiet="quiet splash loglevel=3 rd.udev.log_level=3 udev.log_level=3 systemd.show_status=auto rd.systemd.show_status=auto vt.global_cursor_default=0"
    opts="root=UUID=$root_uuid rw $quiet"
    case "$(findmnt -n -o FSTYPE "$MNT")" in btrfs) opts="$opts rootflags=subvol=@" ;; esac
    [ -r "$MNT/etc/ewe/resume-args" ] && opts="$opts $(cat "$MNT/etc/ewe/resume-args")"
    # timeout 0 = no menu on a normal boot (hold Space for it), like every
    # polished distro; editor no keeps the cmdline out of curious hands
    printf 'default ewe.conf\ntimeout 0\neditor no\nconsole-mode keep\n' > "$MNT/boot/loader/loader.conf"
    printf 'title ewe\nlinux /vmlinuz-linux\ninitrd /initramfs-linux.img\noptions %s\n' \
        "$opts" > "$MNT/boot/loader/entries/ewe.conf"
    # resume hook for hibernation
    if [ -r "$MNT/etc/ewe/resume-args" ]; then
        sed -i 's/^HOOKS=(\(.*\)filesystems/HOOKS=(\1resume filesystems/' "$MNT/etc/mkinitcpio.conf"
        arch-chroot "$MNT" mkinitcpio -P >/dev/null 2>&1 || say bootloader "mkinitcpio warnings (non-fatal)"
    fi
    # dirty FAT buffers + an unclean VM/power stop = zero-length loader files;
    # flushing costs nothing and closes the class
    sync
    say bootloader "done"
    ;;

# ── user <name> <username> — password arrives on stdin, never in argv ───────
user)
    real="$1"; uname="$2"
    valid_user "$uname" || die "invalid username"
    say user "creating $uname"
    arch-chroot "$MNT" useradd -m -G wheel -s /usr/bin/bash -c "$real" "$uname"
    IFS= read -r pw
    printf '%s:%s\n' "$uname" "$pw" | arch-chroot "$MNT" chpasswd
    install -dm750 "$MNT/etc/sudoers.d"
    printf '%%wheel ALL=(ALL:ALL) ALL\n' > "$MNT/etc/sudoers.d/wheel"
    say user "done"
    ;;

# ── settz <zone> / setlocale <locale> / sethostname <name> ──────────────────
settz)
    [ -e "/usr/share/zoneinfo/$1" ] || die "unknown zone"
    ln -sf "/usr/share/zoneinfo/$1" "$MNT/etc/localtime"
    mkdir -p "$MNT/etc/ewe"; : > "$MNT/etc/ewe/manual-timezone"
    say settz "$1" ;;
setlocale)
    # setlocale <locale> [formats] (0.17): the language's locale, en_US.UTF-8
    # always next to it (the fallback every tool and log reads), and the
    # formats' locale; /etc/locale.conf carries LANG and the five regional
    # formats (LC_TIME, LC_NUMERIC, LC_MONETARY, LC_MEASUREMENT, LC_PAPER —
    # the set ewe Settings → Time and place → Formats writes).
    loc="$1"; fmt="${2:-$1}"
    for l in "$loc" "$fmt"; do
        valid_locale "$l" || die "unknown locale: $l"
        grep -q "^#\?$l " "$MNT/etc/locale.gen" || die "unknown locale: $l"
    done
    for l in "$loc" en_US.UTF-8 "$fmt"; do
        sed -i "s|^#$l |$l |" "$MNT/etc/locale.gen"
    done
    arch-chroot "$MNT" locale-gen >/dev/null
    {
        printf 'LANG=%s\n' "$loc"
        for v in LC_TIME LC_NUMERIC LC_MONETARY LC_MEASUREMENT LC_PAPER; do
            printf '%s=%s\n' "$v" "$fmt"
        done
    } > "$MNT/etc/locale.conf"
    say setlocale "$loc (formats: $fmt)" ;;
setkeymap)
    # setkeymap <layouts> <variants> (0.17) — the keyboards as xkb names them,
    # in order ("us,ge", ",qwerty"). X11's keymap for localectl and the
    # greeter (ewe-install's greeter wrapper reads this file), and the
    # console's: the first layout that types Latin letters, as kbd names it
    # (systemd's kbd-model-map), US English when there is none.
    layouts="${1:-us}"; variants="${2:-}"
    valid_layouts "$layouts" "$variants" || die "not a keyboard layout list: $layouts / $variants"
    mountpoint -q "$MNT" || die "target not mounted"
    keymap="$(console_keymap "$layouts" "$variants")"
    printf 'KEYMAP=%s\n' "$keymap" > "$MNT/etc/vconsole.conf"
    install -d "$MNT/etc/X11/xorg.conf.d"
    {
        printf '# Written by the ewe installer (keyboard screen) — localectl owns it now.\n'
        printf 'Section "InputClass"\n        Identifier "system-keyboard"\n        MatchIsKeyboard "on"\n'
        printf '        Option "XkbLayout" "%s"\n' "$layouts"
        [ -z "$variants" ] || printf '        Option "XkbVariant" "%s"\n' "$variants"
        printf 'EndSection\n'
    } > "$MNT/etc/X11/xorg.conf.d/00-keyboard.conf"
    say setkeymap "$layouts${variants:+ ($variants)} — console: $keymap" ;;
sethostname)
    [[ "$1" =~ ^[a-z0-9-]{1,63}$ ]] || die "invalid hostname"
    printf '%s\n' "$1" > "$MNT/etc/hostname"
    say sethostname "$1" ;;

# ── layer — the ewe desktop, exactly the verified ewe-install recipe ────────
layer)
    mountpoint -q "$MNT" || die "target not mounted"
    say layer "delegating to ewe-install --layer-only (the field-tested path)"
    if ! EWE_INSTALL_MNT="$MNT" /usr/local/bin/ewe-install --layer-only 2>&1 | while IFS= read -r l; do
        printf '{"phase":"layer","log":%s}\n' "$(printf '%s' "$l" | python3 -c 'import json,sys;print(json.dumps(sys.stdin.read()[:160]))')"
    done; then
        printf '{"phase":"layer","msg":"the ewe layer failed — usually the [ewe] repo or a mirror was unreachable; check the connection and retry"}\n'
        die "the ewe layer failed — usually the [ewe] repo or a mirror was unreachable; check the connection and retry"
    fi
    say layer "done"
    ;;

# ── addons <id,id,…> — the picked first-party plugins, for every account ────
# ewe 0.25: they are opt-in (the UI says "Plugins"; the verb, the JSON key
# and the parsed lines below keep the old "add-on" word — a contract with
# ewe-install and the GUI). The GUI's Plugins step records ids, this verb
# installs them AS THE NEW USER in the chroot (`ewe-plugin install <id>
# --no-restart`, the ewe-install loop — one implementation, two faces).
# Best-effort by contract: a plugin that fails is reported with
# {"addon":id,"ok":false} and the verb still exits 0 — a plugin can never
# fail the OS install; Komble → Plugins has it afterwards. Only a malformed
# id list or an unmounted target is an error here.
addons)
    ids="${1:-}"
    mountpoint -q "$MNT" || die "target not mounted"
    [[ "$ids" =~ ^[a-z0-9][a-z0-9_-]*(\.[a-z0-9][a-z0-9_-]*)+(,[a-z0-9][a-z0-9_-]*(\.[a-z0-9][a-z0-9_-]*)+)*$ ]] \
        || die "plugin ids must be dotted ids separated by commas (ewe.dock,ewe.media)"
    say addons "installing plugins: ${ids//,/ }"
    # ewe-install's lines, ANSI stripped; its `ok add-on <id>` / `!! add-on
    # <id>: <why>` lines (machine-read — keep the wording) become the
    # per-plugin result objects the GUI shows, everything else is log.
    EWE_INSTALL_MNT="$MNT" /usr/local/bin/ewe-install --addons-only "$ids" 2>&1 | python3 -c '
import json, re, sys
ansi = re.compile(r"\x1b\[[0-9;]*m")
for raw in sys.stdin:
    l = ansi.sub("", raw.rstrip("\n"))
    m = re.match(r"^ok add-on ([^ :]+)(.*)$", l)
    if m:
        print(json.dumps({"phase": "addons", "addon": m.group(1), "ok": True, "msg": l[:200]}), flush=True); continue
    m = re.match(r"^!! add-on ([^ :]+): (.*)$", l)
    if m:
        print(json.dumps({"phase": "addons", "addon": m.group(1), "ok": False, "msg": m.group(2)[:200]}), flush=True); continue
    print(json.dumps({"phase": "addons", "log": l[:160]}), flush=True)
' || say addons "the plugin step ended early — the system is complete; plugins are one click away in Komble → Plugins"
    say addons "done"
    ;;

# ── account <username> <server> <login> <yes|no> — the ewe account ──────────
# (2026-10-31) The user signed in to their own Nextcloud in the installer.
# stdin carries two lines — the new user's password, then the app password
# the server handed out — so neither is ever on argv. The app password goes
# into the new user's LOGIN keyring, created now with the user's password
# (gnome-keyring --unlock): PAM unlocks the same keyring at the first login,
# so the first boot is already signed in. `default` names `login`, so apps
# never make a second keyring that prompts at every boot (Safe's keyring
# repair, 2026-10-18). The non-secret facts go to ~/.config/ewe/cloud.json.
# With `yes` the account's copy of ewe.conf replaces the fresh one
# (`ewe-conf pull` + `apply --no-hooks`, as the user, recorded as synced):
# settings, the folders to sync, the apps Komble offers, the plugin list.
# Best-effort like the plugins: a failing part is reported and the verb
# still exits 0 — the desktop can sign in later, the OS install stands.
account)
    uname="${1:-}"; server="${2:-}"; login="${3:-}"; restore="${4:-no}"
    valid_user "$uname" || die "invalid username"
    [[ "$server" =~ ^https://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._~/-]*)?$ ]] || die "the server must be an https:// address"
    [[ "$login" =~ ^[^[:cntrl:]\ ][^[:cntrl:]]{0,199}$ ]] || die "invalid login name"
    [ "$restore" = yes ] || [ "$restore" = no ] || die "restore must be yes or no"
    mountpoint -q "$MNT" || die "target not mounted"
    IFS= read -r pw || true
    IFS= read -r tok || true
    [ -n "$pw" ] && [ -n "$tok" ] || die "the passwords did not arrive on stdin"
    home="/home/$uname"
    [ -d "$MNT$home" ] || die "no home folder for $uname"
    as_user() {   # as the new user, inside the target, no live-session variables
        arch-chroot "$MNT" runuser -u "$uname" -- env -i HOME="$home" USER="$uname" LOGNAME="$uname" \
            PATH=/usr/local/bin:/usr/bin LANG=C.UTF-8 "$@"
    }
    rt="/tmp/ewe-account.$$"
    arch-chroot "$MNT" runuser -u "$uname" -- install -d -m700 "$rt" "$home/.local/share/keyrings" "$home/.config/ewe"

    say account "the app password goes into $uname's login keyring"
    # (SC2016 here and below: $HOME and $1 expand in the new user's shell, not this one)
    # shellcheck disable=SC2016
    [ -s "$MNT$home/.local/share/keyrings/default" ] || printf 'login' | as_user sh -c 'cat > "$HOME/.local/share/keyrings/default"'
    # shellcheck disable=SC2016
    if printf '%s\n%s\n' "$pw" "$tok" | as_user XDG_RUNTIME_DIR="$rt" dbus-run-session -- sh -c '
            IFS= read -r pw; IFS= read -r tok
            printf %s "$pw" | gnome-keyring-daemon --unlock --components=secrets >/dev/null 2>&1 || exit 3
            printf %s "$tok" | secret-tool store --label="ewe cloud" service ewe-cloud server "$1" user "$2"
        ' sh "$server" "$login" >/dev/null 2>&1; then
        say account "signed in: the keyring holds the app password"
    else
        say account "the keyring step failed — sign in from ewe Sync after the first start"
    fi

    # shellcheck disable=SC2016
    python3 -c 'import json,sys,time; print(json.dumps({"server": sys.argv[1], "user": sys.argv[2], "login_name": sys.argv[2],
        "logged_in_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}))' "$server" "$login" \
        | as_user sh -c 'cat > "$HOME/.config/ewe/cloud.json"'

    if [ "$restore" = yes ]; then
        say account "bringing back your settings, folders and apps from the account"
        # ewe-cloud's file keyring, for this one run only: no session bus here
        # shellcheck disable=SC2016
        printf '%s' "$tok" | as_user sh -c 'umask 077; cat > "$1"' sh "$rt/keyring"
        # shellcheck disable=SC2016
        if as_user EWE_CLOUD_FAKE_KEYRING="$rt/keyring" sh -c '
                t="$HOME/.local/share/ewe/bin/ewe-conf"; [ -x "$t" ] || t=ewe-conf
                "$t" pull | grep -q "\"ok\": true" && "$t" apply --no-hooks >/dev/null' 2>&1 | tail -3 \
            | while IFS= read -r l; do printf '{"phase":"account","log":%s}\n' "$(printf '%s' "$l" | python3 -c 'import json,sys;print(json.dumps(sys.stdin.read()[:160]))')"; done
        then :; fi
        if [ -s "$MNT$home/.local/state/ewe/sync.json" ]; then
            say account "restored: this computer starts with what your account holds"
        else
            say account "the restore did not finish — Welcome offers it again at the first start"
        fi
    fi
    rm -rf "${MNT:?}$rt"
    say account "done"
    ;;

# ── language <user> <layouts> <variants> <ime,ids> <dict> <pkg,pkgs> ─────────
# (0.17) What the Language screen picked, on the new system: ONE pacman run
# for the input method (fcitx5 + its engine — the frontend's list from
# ewe-ime's catalogue, plus whatever `ewe-ime status` in the target still
# misses) and the spelling dictionary; then the new user's ewe.conf, through
# ewe-conf (rule 1) as that user: [desktop.input] kb_layout/kb_variant,
# [desktop.ime] {enabled, engines}, [desktop.language] spellcheck — and
# `ewe-ime apply`, so fcitx5's profile and the session environment are there
# at the first sign-in. Best-effort like the plugins: a part that fails is a
# {"warn":…} line for the Done screen and the verb still exits 0 (the desktop
# offers all of it in ewe Settings). Runs before `account`: a restore brings
# that computer's settings over these.
language)
    uname="${1:-}"; layouts="${2:-us}"; variants="${3:-}"; ime="${4:-}"; dict="${5:-}"; pkgs="${6:-}"
    valid_user "$uname" || die "invalid username"
    valid_layouts "$layouts" "$variants" || die "not a keyboard layout list: $layouts / $variants"
    [ -z "$ime" ] || [[ "$ime" =~ ^[A-Za-z0-9_.-]{1,64}(,[A-Za-z0-9_.-]{1,64}){0,7}$ ]] || die "input method ids look like mozc,pinyin"
    [ -z "$dict" ] || [[ "$dict" =~ ^[a-z]{2,3}(_[A-Z]{2})?(-[A-Za-z0-9]{2,12})?$ ]] || die "not a dictionary name: $dict"
    want=()
    if [ -n "$pkgs" ]; then
        IFS=',' read -ra _p <<< "$pkgs"
        for p in "${_p[@]}"; do
            valid_lang_pkg "$p" || die "not a language package: $p"
            want+=("$p")
        done
    fi
    mountpoint -q "$MNT" || die "target not mounted"
    home="/home/$uname"
    [ -d "$MNT$home" ] || die "no home folder for $uname"
    as_user() {   # as the new user, inside the target, no live-session variables
        arch-chroot "$MNT" runuser -u "$uname" -- env -i HOME="$home" USER="$uname" LOGNAME="$uname" \
            PATH=/usr/local/bin:/usr/bin LANG=C.UTF-8 EWE_IME_NO_SESSION=1 EWE_IME_NO_SCOPE=1 "$@"
    }
    # the deployed copies match the payload ewe-setup just put in the home
    # a tiny sh program for the user's shell ($HOME, $t, $@ expand there)
    # shellcheck disable=SC2016
    tool() { printf 'for t in "$HOME/.local/share/ewe/bin/%s" /usr/bin/%s; do [ -x "$t" ] && exec "$t" "$@"; done; exit 127' "$1" "$1"; }
    conf() { as_user sh -c "$(tool ewe-conf)" ewe-conf set --no-hooks "$@" >/dev/null 2>&1; }

    if [ -n "$ime" ]; then
        engines="$(printf '%s' "$ime" | sed 's/[^,]*/"&"/g; s/,/, /g')"
        # EWE_IME_SELF: write only — ewe-ime applies once its packages are in
        if as_user EWE_IME_SELF=1 sh -c "$(tool ewe-conf)" ewe-conf set --no-hooks desktop.ime \
                "{\"enabled\": true, \"engines\": [$engines]}" >/dev/null 2>&1; then
            say language "typing in other languages: ${ime//,/, }"
        else
            printf '{"phase":"language","warn":"Typing in other languages could not be set up — turn it on in ewe Settings → Keyboard and mouse."}\n'
        fi
        # what ewe-ime itself says the engines need on this target
        while IFS= read -r p; do
            valid_lang_pkg "$p" || continue
            case " ${want[*]} " in *" $p "*) ;; *) want+=("$p") ;; esac
        done < <(as_user sh -c "$(tool ewe-ime)" ewe-ime status 2>/dev/null \
                 | python3 -c 'import json,sys
try: print("\n".join(json.load(sys.stdin).get("missing") or []))
except Exception: pass')
    fi

    if [ "${#want[@]}" -gt 0 ]; then
        say language "installing: ${want[*]}"
        if ! arch-chroot "$MNT" pacman -S --needed --noconfirm "$NO_STALL" "${want[@]}" 2>&1 | while IFS= read -r l; do
            printf '{"phase":"language","log":%s}\n' "$(printf '%s' "$l" | python3 -c 'import json,sys;print(json.dumps(sys.stdin.read()[:160]))')"
        done; then
            printf '{"phase":"language","warn":"The typing and spelling packages (%s) could not be installed — ewe Settings → Language and Keyboard and mouse offer them again."}\n' "${want[*]}"
        fi
    fi

    if [ "$layouts" != us ] || [ -n "$variants" ]; then
        if conf desktop.input.kb_layout "$layouts" && conf desktop.input.kb_variant "$variants"; then
            say language "keyboard: $layouts${variants:+ ($variants)}"
        else
            printf '{"phase":"language","warn":"The keyboard could not be saved for the desktop — pick it again in ewe Settings → Keyboard and mouse."}\n'
        fi
    fi
    if [ -n "$dict" ]; then
        if conf desktop.language.spellcheck "[\"$dict\", \"en_US\"]"; then
            say language "spell checking: $dict + en_US"
        else
            printf '{"phase":"language","warn":"Spell checking could not be saved — pick the dictionary in ewe Settings → Language."}\n'
        fi
    fi
    if [ -n "$ime" ]; then
        # fcitx5's profile on the first keyboard, the candidate window's
        # theme, hypr/generated/ime.env (start-hyprland.sh reads it at the
        # first sign-in) — no session here, so nothing is started or pushed
        as_user sh -c "$(tool ewe-ime)" ewe-ime apply >/dev/null 2>&1 || true
        if [ -s "$MNT$home/.config/fcitx5/profile" ]; then
            say language "typing in other languages is on (Ctrl+Space)"
        else
            printf '{"phase":"language","warn":"Typing in other languages is saved but not ready — ewe Settings → Keyboard and mouse finishes it."}\n'
        fi
    fi
    say language "done"
    ;;

# ── apps <user> <repo,pkgs> [aur:pkg|appimage:pkg …] — apps for day one ──────
# (0.17) Komble's curated apps picked on the Apps screen. Repo apps install
# now, in one pacman run (one by one if that fails); Steam turns on
# [multilib] with the 32-bit Vulkan driver for this GPU (pacman would
# otherwise pick lib32-nvidia-utils on its own). AUR and AppImage picks are
# NEVER built or fetched here: they — and any repo app that did not install —
# go to the new user's ~/.local/state/ewe/install-picks.json, which Komble
# shows as "Apps you picked while installing ewe" (komble-arch README,
# "Install picks"). Best-effort: exits 0 unless the arguments are wrong.
apps)
    uname="${1:-}"; repo="${2:-}"; shift 2 || true
    valid_user "$uname" || die "invalid username"
    mountpoint -q "$MNT" || die "target not mounted"
    home="/home/$uname"
    [ -d "$MNT$home" ] || die "no home folder for $uname"
    rp=()
    if [ -n "$repo" ]; then
        IFS=',' read -ra _r <<< "$repo"
        for p in "${_r[@]}"; do valid_pkg "$p" || die "not a package name: $p"; rp+=("$p"); done
    fi
    picks=()   # "source:pkg"
    for a in "$@"; do
        [[ "$a" =~ ^(aur|appimage):[a-z0-9@_+][a-z0-9@._+-]{0,99}$ ]] || die "picks look like aur:spotify"
        picks+=("$a")
    done
    [ "${#picks[@]}" -le 64 ] && [ "${#rp[@]}" -le 64 ] || die "too many apps"

    applog() { while IFS= read -r l; do
        printf '{"phase":"apps","log":%s}\n' "$(printf '%s' "$l" | python3 -c 'import json,sys;print(json.dumps(sys.stdin.read()[:160]))')"
    done; }
    if [ "${#rp[@]}" -gt 0 ]; then
        extra=()
        case " ${rp[*]} " in *" steam "*)
            if ! grep -q '^\[multilib\]' "$MNT/etc/pacman.conf"; then
                sed -i '/^#\[multilib\]/{N;s/^#\[multilib\]\n#Include = \(.*\)/[multilib]\nInclude = \1/}' "$MNT/etc/pacman.conf"
                say apps "Steam: 32-bit support ([multilib]) turned on"
                arch-chroot "$MNT" pacman -Sy --noconfirm "$NO_STALL" 2>&1 | applog || true
            fi
            gpus="$(lspci -nn 2>/dev/null | grep -Ei 'vga|3d|display' | tr '[:upper:]' '[:lower:]')"
            case "$gpus" in *intel*) extra+=(lib32-vulkan-intel) ;; esac
            case "$gpus" in *\ amd*|*radeon*|*advanced\ micro*) extra+=(lib32-vulkan-radeon) ;; esac
            case "$gpus" in *nvidia*) extra+=(lib32-nvidia-utils) ;; esac
            [ "${#extra[@]}" -gt 0 ] || extra+=(lib32-vulkan-swrast)
            extra+=(lib32-mesa)
            ;;
        esac
        say apps "installing: ${rp[*]}"
        if ! arch-chroot "$MNT" pacman -S --needed --noconfirm "$NO_STALL" "${rp[@]}" "${extra[@]}" 2>&1 | applog; then
            say apps "one go did not work — one app at a time"
            for p in "${rp[@]}"; do
                ex=(); [ "$p" = steam ] && ex=("${extra[@]}")
                if ! arch-chroot "$MNT" pacman -S --needed --noconfirm "$NO_STALL" "$p" "${ex[@]}" 2>&1 | applog; then
                    picks+=("repo:$p")
                fi
            done
        fi
    fi
    nrepo=0
    for a in "${picks[@]}"; do case "$a" in repo:*) nrepo=$((nrepo + 1)) ;; esac; done
    if [ "${#picks[@]}" -gt 0 ]; then
        # the picks file: tiny on purpose — {"version":1,"picked":[{"pkg","source"}]}
        install -d -o "$(stat -c %u "$MNT$home")" -g "$(stat -c %g "$MNT$home")" -m 755 \
            "$MNT$home/.local" "$MNT$home/.local/state" "$MNT$home/.local/state/ewe"
        python3 -c 'import json,sys,time
picked = []
for a in sys.argv[1:]:
    src, pkg = a.split(":", 1)
    if not any(p["pkg"] == pkg for p in picked):
        picked.append({"pkg": pkg, "source": src})
print(json.dumps({"version": 1, "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "picked": picked}, indent=1))' \
            "${picks[@]}" > "$MNT$home/.local/state/ewe/install-picks.json"
        chown "$(stat -c %u:%g "$MNT$home")" "$MNT$home/.local/state/ewe/install-picks.json"
        say apps "waiting in Komble after sign-in: $(printf '%s ' "${picks[@]#*:}")"
    fi
    if [ "$nrepo" -gt 0 ]; then
        printf '{"phase":"apps","warn":"%s app(s) could not be installed now — Komble offers them after you sign in."}\n' "$nrepo"
    fi
    say apps "done"
    ;;

# ── upgrade — the target is CURRENT at first boot ───────────────────────────
# pacstrap + layer install whatever the mirrors held at that moment, and the
# ISO's own package cache may be days old: the first bare-metal install
# (2026-09-02) booted into a desktop that immediately owed a large update.
# One full -Syu in the chroot, before the bootloader step reads the final
# kernel + microcode, so the user never meets "updates pending" on login.
upgrade)
    mountpoint -q "$MNT" || die "target not mounted"
    say upgrade "updating the installed system (kernel, firmware, the desktop)"
    if ! arch-chroot "$MNT" pacman -Syu --noconfirm "$NO_STALL" 2>&1 | while IFS= read -r l; do
        printf '{"phase":"upgrade","log":%s}\n' "$(printf '%s' "$l" | python3 -c 'import json,sys;print(json.dumps(sys.stdin.read()[:160]))')"
    done; then
        printf '{"phase":"upgrade","msg":"the update after install failed — check the connection and retry"}\n'
        die "the update after install failed — check the connection and retry"
    fi
    say upgrade "the installed system is current"
    ;;

reboot)
    say reboot "unmounting and rebooting"
    umount -R "$MNT" 2>/dev/null || true
    systemctl reboot
    ;;

*) die "unknown verb: $verb" ;;
esac
