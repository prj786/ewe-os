{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ewe-installer",
  "version": "0.1.0",
  "identifier": "io.github.prj786.ewe.installer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5175",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Install ewe",
        "width": 900,
        "height": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: https://*.googleusercontent.com; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$HOME/.face",
          "$HOME/.cache/ewe-avatar.png"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "category": "Settings",
    "shortDescription": "Settings for the ewe desktop",
    "longDescription": "The settings application for the ewe desktop: appearance, displays, input, power and startup. Writes the same configuration files the shell reads and asks it to reload.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}