#!/usr/bin/env bash
# ewe-install — guided installation of the ewe desktop onto a disk.
#
# archinstall does what it's good at (disks, locale, users, bootloader,
# network); this wrapper then layers the DE onto the mounted target:
#   [ewe] repo → target pacman.conf · the `ewe` package · the greeter stack
#   (greetd → cage → Quickshell greeter, exactly install.sh phase 30's
#   recipe, read from the package payload) · per-user deploy for every human
#   account · the add-ons the user picked — so the installed machine boots
#   straight into the graphical greeter with the desktop ready.
#
# The live ISO's pacman.conf already carries [ewe], so pacstrap resolves the
# `ewe` package during archinstall; this script only has to configure, not
# download the world twice.
#
#   ewe-install                      guided: archinstall, then the ewe layer
#                                    (asks which add-ons to install)
#   ewe-install --addons ID,ID       guided, with the add-ons decided up front
#   ewe-install --layer-only [--addons ID,ID]
#                                    skip archinstall — layer onto whatever is
#                                    already mounted at /mnt/archinstall (resume
#                                    after an interrupted run, or scripted
#                                    installs; ewe-installer's `layer` verb)
#   ewe-install --addons-only ID,ID  only the add-ons, for every account on
#                                    the mounted target (ewe-installer's
#                                    `addons` verb; the layer must be done)
#   ewe-install --help
#
# Add-ons (ewe 0.25): every first-party extra — the dock, clipboard history,
# screenshots, music, Places, phone, mail, Cast to TV… — ships in the payload
# but is NOT installed on a fresh account; `ewe-setup` records them as
# considered (`ewe-plugin migrate --fresh`) and installs none. The ids given
# here are installed for the new user with `ewe-plugin install <id>
# --no-restart` inside the chroot, each one best-effort: a failing add-on is
# reported (`!! add-on <id>: …`) and never aborts the install. The list of
# ids is the live payload's: `ewe-plugin list --json` → available[], or
# /usr/share/ewe/plugins/bundle.json.
set -uo pipefail

MNT="${EWE_INSTALL_MNT:-/mnt/archinstall}"
REPO_STANZA='\n[ewe]\nSigLevel = Required DatabaseRequired\nServer = https://github.com/prj786/ewe-repo/releases/download/x86_64\n'
# the LIVE system's payload — where the add-on catalogue is read from
LIVE_PLUGINS="${EWE_PAYLOAD_PLUGINS:-/usr/share/ewe/plugins}"

say() { printf '\033[1;36m::\033[0m %s\n' "$*"; }
ok()  { printf '\033[1;32mok\033[0m %s\n' "$*"; }
die() { printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
    sed -n '2,/^set -uo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'
}

# ── the chroot seams: everything that runs ON THE TARGET goes through these
# two, so the add-on loop can be exercised against a sandbox (tests override
# them) and so a future change of chroot tool is one line ──────────────────
chroot_root() { arch-chroot "$MNT" "$@"; }
# as a target user: runuser (no -m) resets HOME/USER/LOGNAME/SHELL from passwd;
# the Hyprland/Wayland/D-Bus variables are dropped on purpose — ewe's tools
# otherwise reload whatever compositor the caller's environment names
# (the live session's), and there is nothing to talk to inside a chroot.
chroot_user() {
    local u="$1"; shift
    arch-chroot "$MNT" runuser -u "$u" -- \
        env -u HYPRLAND_INSTANCE_SIGNATURE -u WAYLAND_DISPLAY -u DBUS_SESSION_BUS_ADDRESS "$@"
}

valid_addon_id() { [[ "$1" =~ ^[a-z0-9][a-z0-9_-]{0,31}(\.[a-z0-9][a-z0-9_-]{0,31})+$ ]]; }
valid_addon_list() { [ -n "$1" ] && [[ "$1" =~ ^[a-z0-9][a-z0-9_.-]*(,[a-z0-9][a-z0-9_.-]*)*$ ]]; }

# The live payload's catalogue, one add-on per line: "id<TAB>name — description"
addon_catalogue() {
    [ -r "$LIVE_PLUGINS/bundle.json" ] || return 1
    python3 - "$LIVE_PLUGINS" <<'PY'
import json, os, sys
d = sys.argv[1]
try:
    b = json.load(open(os.path.join(d, "bundle.json"))).get("plugins") or {}
except (OSError, ValueError):
    sys.exit(1)
for pid in sorted(b):
    try:
        m = json.load(open(os.path.join(d, pid, "manifest.json")))
    except (OSError, ValueError):
        continue
    if m.get("id") != pid:
        continue
    print("%s\t%s — %s" % (pid, m.get("name") or pid, (m.get("description") or "").split(". ")[0].rstrip(".")))
PY
}

# install_addons <user> <id,id,…> — the loop (one implementation, two faces:
# the TUI prints these lines, ewe-installer's helper turns `ok add-on <id>`
# and `!! add-on <id>: <why>` into its per-add-on result objects).
# Never returns non-zero because of an add-on.
install_addons() {
    local u="$1" ids="$2" id out rc verdict why pkgs
    local -a list
    IFS=',' read -ra list <<< "$ids"
    for id in "${list[@]}"; do
        [ -n "$id" ] || continue
        if ! valid_addon_id "$id"; then
            echo "!! add-on $id: not an add-on id (expected something like ewe.dock)"
            continue
        fi
        say "add-on $id for '$u'"
        # the tool prints ONE JSON object (ok/error/missing) and exits 1 on
        # an unknown id — never let a failure here stop the loop. The copy
        # ewe-setup just deployed into the home is the one that matches that
        # payload (the same rule ewe-setup applies); /usr/bin's is the fallback.
        out="$(chroot_user "$u" sh -c 't="$HOME/.local/share/ewe/bin/ewe-plugin"; [ -x "$t" ] || t=ewe-plugin; exec "$t" "$@"' \
                   ewe-plugin install "$id" --no-restart 2>&1)"; rc=$?
        verdict="$(printf '%s\n' "$out" | python3 -c '
import json, sys
j = None
for l in reversed(sys.stdin.read().splitlines()):
    l = l.strip()
    if l.startswith("{"):
        try:
            j = json.loads(l); break
        except ValueError:
            pass
if not isinstance(j, dict):
    print("ERR\tewe-plugin printed no result"); sys.exit(0)
if j.get("ok") is True:
    print("OK\t" + " ".join((j.get("missing") or {}).get("packages") or []))
else:
    print("ERR\t" + str(j.get("error") or "ewe-plugin install failed"))
' 2>/dev/null)"
        case "$verdict" in
            OK*)
                pkgs="${verdict#OK}"; pkgs="${pkgs#	}"
                if [ -n "$pkgs" ]; then
                    # declared package needs the add-on reported missing — the
                    # job Komble does on a running machine (ewe's deps cover
                    # them today, so this is normally a no-op)
                    say "add-on $id needs: $pkgs"
                    # shellcheck disable=SC2086
                    chroot_root pacman -S --noconfirm --needed $pkgs \
                        || echo "!! packages for add-on $id ($pkgs) could not be installed — the add-on is enabled; install them later with Komble"
                fi
                ok "add-on $id installed and enabled for '$u'"
                ;;
            *)
                why="${verdict#ERR}"; why="${why#	}"
                [ -n "$why" ] || why="ewe-plugin install exited $rc"
                echo "!! add-on $id: $why — add it later in Komble → Add-ons"
                ;;
        esac
    done
    return 0
}

# every human account on the mounted target (the ones archinstall / the
# installer's `user` verb created)
target_users() {
    local home u
    for home in "$MNT"/home/*; do
        [ -d "$home" ] || continue
        u="$(basename "$home")"
        chroot_root id "$u" >/dev/null 2>&1 || continue
        printf '%s\n' "$u"
    done
}

# sourced by tests (`EWE_INSTALL_LIB=1 . ewe-install`): functions only
if [ "${EWE_INSTALL_LIB:-}" = 1 ]; then
    return 0 2>/dev/null || exit 0
fi

# ── arguments ────────────────────────────────────────────────────────────────
ORIG_ARGS=("$@")     # re-exec under sudo gets the untouched command line
MODE=guided          # guided | layer | addons
ADDONS=""            # comma-separated ids; "" = none
ADDONS_GIVEN=0       # --addons was on the command line (no prompt)
while [ $# -gt 0 ]; do
    case "$1" in
        --layer-only) MODE=layer ;;
        --addons-only)
            MODE=addons; ADDONS="${2:-}"; ADDONS_GIVEN=1; shift
            valid_addon_list "$ADDONS" || die "--addons-only needs a comma-separated list of ids (ewe.dock,ewe.media)" ;;
        --addons-only=*)
            MODE=addons; ADDONS="${1#*=}"; ADDONS_GIVEN=1
            valid_addon_list "$ADDONS" || die "--addons-only needs a comma-separated list of ids (ewe.dock,ewe.media)" ;;
        --addons)
            ADDONS="${2:-}"; ADDONS_GIVEN=1; shift
            [ -z "$ADDONS" ] || valid_addon_list "$ADDONS" || die "--addons needs a comma-separated list of ids (ewe.dock,ewe.media)" ;;
        --addons=*)
            ADDONS="${1#*=}"; ADDONS_GIVEN=1
            [ -z "$ADDONS" ] || valid_addon_list "$ADDONS" || die "--addons needs a comma-separated list of ids (ewe.dock,ewe.media)" ;;
        -h|--help) usage; exit 0 ;;
        *) die "unknown option: $1 (see --help)" ;;
    esac
    shift
done

[ "$(id -u)" = 0 ] || exec sudo "$0" "${ORIG_ARGS[@]}"

# ── add-ons only (ewe-installer's `addons` verb) ─────────────────────────────
if [ "$MODE" = addons ]; then
    mountpoint -q "$MNT" || die "target not mounted at $MNT — nothing to install add-ons into."
    found_user=0
    while IFS= read -r u; do
        found_user=1
        install_addons "$u" "$ADDONS"
    done < <(target_users)
    [ "$found_user" = 1 ] || die "no user account found on the target."
    exit 0
fi

if [ "$MODE" = guided ]; then
    cat <<'EOF'

  ewe — guided install (alpha)
  ────────────────────────────
  archinstall runs first for the base system. Inside it:
    · partition/format as you like
    · Authentication → add YOUR USER ACCOUNT (make it a superuser)
    · Profile: leave empty/minimal — the desktop is layered on afterwards
    · Additional packages: leave empty
    · when it finishes, answer NO to "chroot into installation" — this
      script continues from there
EOF
    # Add-ons — asked here, before archinstall, so the whole run is
    # unattended afterwards. Nothing is pre-selected (add-ons are opt-in);
    # Enter means none, and Komble → Add-ons has them all later.
    if [ "$ADDONS_GIVEN" = 0 ] && catalogue="$(addon_catalogue)" && [ -n "$catalogue" ]; then
        cat <<'EOF'

  Add-ons — extras that ship with ewe but are not installed until you ask.
  Type the ids you want, separated by commas (Enter for none; everything
  stays one click away in Komble → Add-ons):
EOF
        printf '%s\n' "$catalogue" | while IFS=$'\t' read -r id rest; do
            hint=""; [ "$id" = ewe.dock ] && hint="   (recommended if you like a dock)"
            printf '    %-16s %s%s\n' "$id" "$rest" "$hint"
        done
        echo
        while :; do
            read -rp "  add-ons [none]: " ADDONS
            ADDONS="${ADDONS// /}"
            [ -z "$ADDONS" ] && break
            valid_addon_list "$ADDONS" && break
            echo "  ids look like ewe.dock, separated by commas"
        done
    fi
    read -rp "Press Enter to start archinstall… "

    archinstall || die "archinstall did not complete."
fi
mountpoint -q "$MNT" || die "target not mounted at $MNT — nothing to layer onto."

say "layering the ewe desktop onto the target"

# 0 · trust the [ewe] signing key on the target (the repo is signed; without
# this the very first -Sy fails). Key comes from the live env's own payload.
# NOT $MNT/tmp: arch-chroot mounts a fresh tmpfs over the target's /tmp, so a
# key staged there is gone by the time pacman-key looks (found by the 0.8
# upgrade-path test, 2026-09-01). /root survives the chroot.
install -Dm644 /usr/share/ewe/system/ewe.gpg "$MNT/root/ewe.gpg"
chroot_root pacman-key --add /root/ewe.gpg
chroot_root pacman-key --lsign-key 639CA544B61509B3FC2621ABADBCD432FC0763C1
rm -f "$MNT/root/ewe.gpg"

# 1 · the [ewe] repo, so pacman -Syu keeps updating the DE after install
# (pipewire-jack is named explicitly for the same reason as the ISO's package
# list: a dependency's 'jack' requirement would otherwise auto-pick jack2 and
# conflict with the pipewire-jack inside ewe's own tree)
grep -q '^\[ewe\]' "$MNT/etc/pacman.conf" \
    || printf "$REPO_STANZA" >> "$MNT/etc/pacman.conf"
chroot_root pacman -Sy --noconfirm --needed pipewire-jack fuse2 ewe \
    || die "installing the ewe package on the target failed."
ok "[ewe] repo + ewe package on the target"

# 1b · GPU drivers for THIS machine's hardware (the ewe package is
# deliberately vendor-clean — mesa only; shipping every vendor's stack to
# every machine is bloat, so the right drivers are chosen HERE, mirroring
# install.sh phase 40). The live kernel sees the same hardware the target
# will boot on.
gpus="$(lspci -nn 2>/dev/null | grep -Ei 'vga|3d|display' | tr '[:upper:]' '[:lower:]')"
gpu_pkgs=""
case "$gpus" in *intel*) gpu_pkgs="$gpu_pkgs vulkan-intel intel-media-driver vpl-gpu-rt" ;; esac
case "$gpus" in *\ amd*|*radeon*|*advanced\ micro*) gpu_pkgs="$gpu_pkgs vulkan-radeon libva-mesa-driver" ;; esac
case "$gpus" in *nvidia*) gpu_pkgs="$gpu_pkgs nvidia-open-dkms nvidia-utils egl-wayland linux-headers" ;; esac
if [ -n "$gpu_pkgs" ]; then
    say "GPU driver set for this hardware:$gpu_pkgs"
    # shellcheck disable=SC2086
    chroot_root pacman -S --noconfirm --needed $gpu_pkgs \
        || echo "!! GPU driver install failed — the desktop still runs on mesa; install them later with Komble."
else
    say "no discrete GPU vendor detected — mesa covers it"
fi

# 2 · the greeter stack — install.sh phase 30's recipe, files from the payload
P=/usr/share/ewe   # inside the target
chroot_root bash -s <<CHROOT || die "greeter setup failed."
set -euo pipefail
install -d /etc/greetd
install -m 644 $P/system/greetd/config.toml  /etc/greetd/config.toml
install -m 644 $P/system/greetd/regreet.toml /etc/greetd/regreet.toml
install -d /etc/xdg/quickshell/ewe-greeter
install -m 644 $P/system/greeter/shell.qml /etc/xdg/quickshell/ewe-greeter/shell.qml
{ printf '#!/bin/sh\n# Generated by ewe-install. Greeter session wrapper run by greetd.\n'
  printf 'export WLR_NO_HARDWARE_CURSORS=1\n'
  printf 'export XDG_CONFIG_DIRS="\${XDG_CONFIG_DIRS:-/etc/xdg}"\n'
  printf 'export XDG_CACHE_HOME="\${XDG_CACHE_HOME:-/tmp/ewe-greeter}"\n'
  printf 'export QT_QPA_PLATFORM=wayland\n'
  printf 'export QT_WAYLAND_DISABLE_WINDOWDECORATION=1\n'
  printf 'exec cage -s -- sh -c "qs -c ewe-greeter || regreet"\n'
} > /usr/local/bin/ewe-greeter
chmod 755 /usr/local/bin/ewe-greeter
# the keyring is unlocked by PAM at the greeter (pam_gnome_keyring auth +
# session): without this file the first account sign-in meets a "new keyring"
# prompt instead of a ready one (first bare-metal install, 2026-09-02).
# gnome-keyring is a hard dependency of ewe, so its absence is a broken box.
[ -f /usr/lib/security/pam_gnome_keyring.so ] \
    || { echo "xx pam_gnome_keyring.so is missing on the target — gnome-keyring should have come with ewe" >&2; exit 1; }
install -m 644 $P/system/pam.d/greetd /etc/pam.d/greetd
install -m 755 $P/system/bin/ewe-share-picker /usr/local/bin/ewe-share-picker
# greetd drop-in (phase 35's): ordered after plymouth-quit-wait, the
# black-screen guard, and — since 2026-09-01, config.toml vt = 1 — the
# getty@tty1 conflict that makes splash → greeter one seamless cut (the
# design this very ISO proved). Rescue console on tty3, as on the ISO.
install -d /etc/systemd/system/greetd.service.d
install -m 644 $P/system/greetd/plymouth.conf /etc/systemd/system/greetd.service.d/plymouth.conf
systemctl enable greetd.service getty@tty3.service NetworkManager.service bluetooth.service \
    power-profiles-daemon.service systemd-timesyncd.service avahi-daemon.service
CHROOT
ok "greeter (greetd → cage → Quickshell greeter) + core services enabled"
# The login keyring is CREATED by pam_gnome_keyring at the first login, with
# the login password — never by a hidden "new keyring" prompt in the session
# (the 2026-09-02 metal failure). Assert the PAM stack really carries it.
grep -q pam_gnome_keyring "$MNT/etc/pam.d/greetd" \
    || die "/etc/pam.d/greetd on the target lacks pam_gnome_keyring — the login keyring would never unlock."

# 2b · CPU microcode for this machine (mirrors install.sh phase 37); the
# mkinitcpio `microcode` hook picks it up on the rebuild below
case "$(grep -m1 vendor_id /proc/cpuinfo 2>/dev/null)" in
    *GenuineIntel*) ucode=intel-ucode ;;
    *AuthenticAMD*) ucode=amd-ucode ;;
    *)              ucode="" ;;
esac
if [ -n "$ucode" ]; then
    chroot_root pacman -S --noconfirm --needed "$ucode" \
        && ok "CPU microcode: $ucode" \
        || echo "!! $ucode install failed — boot works without it, install later."
fi

# 2c · the target is CURRENT at first boot: pacstrap/layer took whatever the
# mirrors held at that moment and the ISO cache may be days old — the first
# metal install (2026-09-02) booted into a large pending update. One full
# upgrade here, before the initramfs rebuild below sees the final kernel.
say "updating the installed system (kernel, firmware, the desktop)"
chroot_root pacman -Syu --noconfirm \
    || die "the update after install failed — check the connection and retry."
ok "installed system is current"

# 2c · branded, silent boot — the Ubuntu/Fedora treatment (phase 35's recipe):
# the ewe plymouth theme from the payload, the plymouth hook AFTER kms (the
# DRM driver must be up before plymouthd or the splash falls back to the
# framebuffer), and an os-release that says ewe, not Arch — this machine
# introduces itself as ewe everywhere (bootloader titles, GRUB probes, apps).
chroot_root bash -s <<CHROOT || die "boot branding failed."
set -euo pipefail
dst=/usr/share/plymouth/themes/ewe
install -d "\$dst"
# stock spinner frames + our watermark/colours — same trick as phase 35
[ -d /usr/share/plymouth/themes/spinner ] && cp -f /usr/share/plymouth/themes/spinner/*.png "\$dst"/
install -m 644 $P/system/plymouth/ewe/watermark.png "\$dst/watermark.png"
install -m 644 $P/system/plymouth/ewe/ewe.plymouth  "\$dst/ewe.plymouth"
install -d /etc/plymouth
printf '[Daemon]\nTheme=ewe\nShowDelay=0\n' > /etc/plymouth/plymouthd.conf
if ! grep -qE '^HOOKS=.*\bplymouth\b' /etc/mkinitcpio.conf; then
    sed -i -E 's/^(HOOKS=\(.*\bkms)\b/\1 plymouth/' /etc/mkinitcpio.conf
    grep -qE '^HOOKS=.*\bplymouth\b' /etc/mkinitcpio.conf \
        || sed -i -E 's/^(HOOKS=\(.*\budev)\b/\1 plymouth/' /etc/mkinitcpio.conf
fi
cat > /etc/os-release <<'OSREL'
NAME="ewe"
PRETTY_NAME="ewe"
ID=ewe
ID_LIKE=arch
BUILD_ID=rolling
ANSI_COLOR="38;2;238;180;7"
HOME_URL="https://github.com/prj786/ewe"
BUG_REPORT_URL="https://github.com/prj786/ewe/issues"
LOGO=ewe
OSREL
mkinitcpio -P >/dev/null 2>&1 || echo "!! mkinitcpio warnings (non-fatal)"
CHROOT
ok "branded silent boot: ewe splash + microcode + ewe os-release"

# 3 · per-user deploy + session entry for every human account archinstall made.
# ewe-setup on a FRESH home runs `ewe-plugin seed` + `migrate --fresh`: the
# add-ons are recorded as considered and NONE is installed (0.25, opt-in);
# the ones picked for this install follow right after it.
found_user=0
while IFS= read -r u; do
    found_user=1
    say "deploying the desktop for user '$u'"
    chroot_user "$u" ewe-setup \
        || die "per-user deploy failed for $u."
    # session entry the greeter lists — points at this user's wrapper
    wrap="/home/$u/.config/hypr/start-hyprland.sh"
    for d in usr/share/wayland-sessions usr/local/share/wayland-sessions; do
        install -d "$MNT/$d"
        sed "s|@EXEC@|$wrap|g" "$MNT$P/templates/hyprland-de.desktop.in" \
            > "$MNT/$d/hyprland-de.desktop"
    done
    [ -z "$ADDONS" ] || install_addons "$u" "$ADDONS"
    ok "user '$u' ready"
done < <(target_users)
[ "$found_user" = 1 ] || die "no user account found on the target — create one in archinstall and re-run."

cat <<'EOF'

  ✓ done — reboot into ewe.
    The greeter lists "Ewe"; log in with the account you created.
    Later: `sudo pacman -Syu` updates the whole desktop; Komble is the store
    and Komble → Add-ons has every extra that ships with ewe.
EOF
