#!/usr/bin/env bash
# ewe-install — guided installation of the ewe desktop onto a disk.
#
# archinstall does what it's good at (disks, locale, users, bootloader,
# network); this wrapper then layers the DE onto the mounted target:
#   [ewe] repo → target pacman.conf · the `ewe` package · the greeter stack
#   (greetd → cage → Quickshell greeter, exactly install.sh phase 30's
#   recipe, read from the package payload) · per-user deploy for every human
#   account — so the installed machine boots straight into the graphical
#   greeter with the desktop ready.
#
# The live ISO's pacman.conf already carries [ewe], so pacstrap resolves the
# `ewe` package during archinstall; this script only has to configure, not
# download the world twice.
#
#   ewe-install                guided: archinstall, then the ewe layer
#   ewe-install --layer-only   skip archinstall — layer onto whatever is
#                              already mounted at /mnt/archinstall (resume
#                              after an interrupted run, or scripted installs)
set -uo pipefail

MNT="${EWE_INSTALL_MNT:-/mnt/archinstall}"
REPO_STANZA='\n[ewe]\nSigLevel = Required DatabaseRequired\nServer = https://github.com/prj786/ewe-repo/releases/download/x86_64\n'

say() { printf '\033[1;36m::\033[0m %s\n' "$*"; }
ok()  { printf '\033[1;32mok\033[0m %s\n' "$*"; }
die() { printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; exit 1; }

[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"

if [ "${1:-}" != "--layer-only" ]; then
    cat <<'EOF'

  ewe — guided install (alpha)
  ────────────────────────────
  archinstall runs first for the base system. Inside it:
    · partition/format as you like
    · Authentication → add YOUR USER ACCOUNT (make it a superuser)
    · Profile: leave empty/minimal — the desktop is layered on afterwards
    · Additional packages: leave empty
    · when it finishes, answer NO to "chroot into installation" — this
      script continues from there
EOF
    read -rp "Press Enter to start archinstall… "

    archinstall || die "archinstall did not complete."
fi
mountpoint -q "$MNT" || die "target not mounted at $MNT — nothing to layer onto."

say "layering the ewe desktop onto the target"

# 0 · trust the [ewe] signing key on the target (the repo is signed; without
# this the very first -Sy fails). Key comes from the live env's own payload.
# NOT $MNT/tmp: arch-chroot mounts a fresh tmpfs over the target's /tmp, so a
# key staged there is gone by the time pacman-key looks (found by the 0.8
# upgrade-path test, 2026-09-01). /root survives the chroot.
install -Dm644 /usr/share/ewe/system/ewe.gpg "$MNT/root/ewe.gpg"
arch-chroot "$MNT" pacman-key --add /root/ewe.gpg
arch-chroot "$MNT" pacman-key --lsign-key 639CA544B61509B3FC2621ABADBCD432FC0763C1
rm -f "$MNT/root/ewe.gpg"

# 1 · the [ewe] repo, so pacman -Syu keeps updating the DE after install
# (pipewire-jack is named explicitly for the same reason as the ISO's package
# list: a dependency's 'jack' requirement would otherwise auto-pick jack2 and
# conflict with the pipewire-jack inside ewe's own tree)
grep -q '^\[ewe\]' "$MNT/etc/pacman.conf" \
    || printf "$REPO_STANZA" >> "$MNT/etc/pacman.conf"
arch-chroot "$MNT" pacman -Sy --noconfirm --needed pipewire-jack fuse2 ewe \
    || die "installing the ewe package on the target failed."
ok "[ewe] repo + ewe package on the target"

# 1b · GPU drivers for THIS machine's hardware (the ewe package is
# deliberately vendor-clean — mesa only; shipping every vendor's stack to
# every machine is bloat, so the right drivers are chosen HERE, mirroring
# install.sh phase 40). The live kernel sees the same hardware the target
# will boot on.
gpus="$(lspci -nn 2>/dev/null | grep -Ei 'vga|3d|display' | tr '[:upper:]' '[:lower:]')"
gpu_pkgs=""
case "$gpus" in *intel*) gpu_pkgs="$gpu_pkgs vulkan-intel intel-media-driver vpl-gpu-rt" ;; esac
case "$gpus" in *\ amd*|*radeon*|*advanced\ micro*) gpu_pkgs="$gpu_pkgs vulkan-radeon libva-mesa-driver" ;; esac
case "$gpus" in *nvidia*) gpu_pkgs="$gpu_pkgs nvidia-open-dkms nvidia-utils egl-wayland linux-headers" ;; esac
if [ -n "$gpu_pkgs" ]; then
    say "GPU driver set for this hardware:$gpu_pkgs"
    # shellcheck disable=SC2086
    arch-chroot "$MNT" pacman -S --noconfirm --needed $gpu_pkgs \
        || echo "!! GPU driver install failed — the desktop still runs on mesa; install them later with Komble."
else
    say "no discrete GPU vendor detected — mesa covers it"
fi

# 2 · the greeter stack — install.sh phase 30's recipe, files from the payload
P=/usr/share/ewe   # inside the target
arch-chroot "$MNT" bash -s <<CHROOT || die "greeter setup failed."
set -euo pipefail
install -d /etc/greetd
install -m 644 $P/system/greetd/config.toml  /etc/greetd/config.toml
install -m 644 $P/system/greetd/regreet.toml /etc/greetd/regreet.toml
install -d /etc/xdg/quickshell/ewe-greeter
install -m 644 $P/system/greeter/shell.qml /etc/xdg/quickshell/ewe-greeter/shell.qml
{ printf '#!/bin/sh\n# Generated by ewe-install. Greeter session wrapper run by greetd.\n'
  printf 'export WLR_NO_HARDWARE_CURSORS=1\n'
  printf 'export XDG_CONFIG_DIRS="\${XDG_CONFIG_DIRS:-/etc/xdg}"\n'
  printf 'export XDG_CACHE_HOME="\${XDG_CACHE_HOME:-/tmp/ewe-greeter}"\n'
  printf 'export QT_QPA_PLATFORM=wayland\n'
  printf 'export QT_WAYLAND_DISABLE_WINDOWDECORATION=1\n'
  printf 'exec cage -s -- sh -c "qs -c ewe-greeter || regreet"\n'
} > /usr/local/bin/ewe-greeter
chmod 755 /usr/local/bin/ewe-greeter
# the keyring is unlocked by PAM at the greeter (pam_gnome_keyring auth +
# session): without this file the first Google sign-in meets a "new keyring"
# prompt instead of a ready one (first bare-metal install, 2026-09-02).
# gnome-keyring is a hard dependency of ewe, so its absence is a broken box.
[ -f /usr/lib/security/pam_gnome_keyring.so ] \
    || { echo "xx pam_gnome_keyring.so is missing on the target — gnome-keyring should have come with ewe" >&2; exit 1; }
install -m 644 $P/system/pam.d/greetd /etc/pam.d/greetd
install -m 755 $P/system/bin/ewe-share-picker /usr/local/bin/ewe-share-picker
# greetd drop-in (phase 35's): ordered after plymouth-quit-wait, the
# black-screen guard, and — since 2026-09-01, config.toml vt = 1 — the
# getty@tty1 conflict that makes splash → greeter one seamless cut (the
# design this very ISO proved). Rescue console on tty3, as on the ISO.
install -d /etc/systemd/system/greetd.service.d
install -m 644 $P/system/greetd/plymouth.conf /etc/systemd/system/greetd.service.d/plymouth.conf
systemctl enable greetd.service getty@tty3.service NetworkManager.service bluetooth.service \
    power-profiles-daemon.service systemd-timesyncd.service avahi-daemon.service
CHROOT
ok "greeter (greetd → cage → Quickshell greeter) + core services enabled"

# 2b · CPU microcode for this machine (mirrors install.sh phase 37); the
# mkinitcpio `microcode` hook picks it up on the rebuild below
case "$(grep -m1 vendor_id /proc/cpuinfo 2>/dev/null)" in
    *GenuineIntel*) ucode=intel-ucode ;;
    *AuthenticAMD*) ucode=amd-ucode ;;
    *)              ucode="" ;;
esac
if [ -n "$ucode" ]; then
    arch-chroot "$MNT" pacman -S --noconfirm --needed "$ucode" \
        && ok "CPU microcode: $ucode" \
        || echo "!! $ucode install failed — boot works without it, install later."
fi

# 2c · branded, silent boot — the Ubuntu/Fedora treatment (phase 35's recipe):
# the ewe plymouth theme from the payload, the plymouth hook AFTER kms (the
# DRM driver must be up before plymouthd or the splash falls back to the
# framebuffer), and an os-release that says ewe, not Arch — this machine
# introduces itself as ewe everywhere (bootloader titles, GRUB probes, apps).
arch-chroot "$MNT" bash -s <<CHROOT || die "boot branding failed."
set -euo pipefail
dst=/usr/share/plymouth/themes/ewe
install -d "\$dst"
# stock spinner frames + our watermark/colours — same trick as phase 35
[ -d /usr/share/plymouth/themes/spinner ] && cp -f /usr/share/plymouth/themes/spinner/*.png "\$dst"/
install -m 644 $P/system/plymouth/ewe/watermark.png "\$dst/watermark.png"
install -m 644 $P/system/plymouth/ewe/ewe.plymouth  "\$dst/ewe.plymouth"
install -d /etc/plymouth
printf '[Daemon]\nTheme=ewe\nShowDelay=0\n' > /etc/plymouth/plymouthd.conf
if ! grep -qE '^HOOKS=.*\bplymouth\b' /etc/mkinitcpio.conf; then
    sed -i -E 's/^(HOOKS=\(.*\bkms)\b/\1 plymouth/' /etc/mkinitcpio.conf
    grep -qE '^HOOKS=.*\bplymouth\b' /etc/mkinitcpio.conf \
        || sed -i -E 's/^(HOOKS=\(.*\budev)\b/\1 plymouth/' /etc/mkinitcpio.conf
fi
cat > /etc/os-release <<'OSREL'
NAME="ewe"
PRETTY_NAME="ewe"
ID=ewe
ID_LIKE=arch
BUILD_ID=rolling
ANSI_COLOR="38;2;10;132;255"
HOME_URL="https://github.com/prj786/ewe"
BUG_REPORT_URL="https://github.com/prj786/ewe/issues"
LOGO=ewe
OSREL
mkinitcpio -P >/dev/null 2>&1 || echo "!! mkinitcpio warnings (non-fatal)"
CHROOT
ok "branded silent boot: ewe splash + microcode + ewe os-release"

# 3 · per-user deploy + session entry for every human account archinstall made
found_user=0
for home in "$MNT"/home/*; do
    [ -d "$home" ] || continue
    u="$(basename "$home")"
    arch-chroot "$MNT" id "$u" >/dev/null 2>&1 || continue
    found_user=1
    say "deploying the desktop for user '$u'"
    arch-chroot "$MNT" runuser -u "$u" -- ewe-setup \
        || die "per-user deploy failed for $u."
    # session entry the greeter lists — points at this user's wrapper
    wrap="/home/$u/.config/hypr/start-hyprland.sh"
    for d in usr/share/wayland-sessions usr/local/share/wayland-sessions; do
        install -d "$MNT/$d"
        sed "s|@EXEC@|$wrap|g" "$MNT$P/templates/hyprland-de.desktop.in" \
            > "$MNT/$d/hyprland-de.desktop"
    done
    ok "user '$u' ready"
done
[ "$found_user" = 1 ] || die "no user account found on the target — create one in archinstall and re-run."

cat <<'EOF'

  ✓ done — reboot into ewe.
    The greeter lists "Ewe"; log in with the account you created.
    Later: `sudo pacman -Syu` updates the whole desktop; Komble is the store.
EOF
