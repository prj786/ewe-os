#!/usr/bin/env bash
# Live-session bootstrap, run by greetd as the live user. The DE was already
# deployed into this home at boot by ewe-live-user.service, under the plymouth
# splash (see ewe-live-deploy) — so normally this is a thin exec of the
# standard session wrapper, the exact same path an installed system takes.
# If that boot-time deploy did not happen, do it here: never a black screen.
set -u

# Live marker: the DE's autostart skips the idle/lock daemon entirely when it
# sees this — the live user has an empty password, so a lock is a dead end.
export EWE_LIVE=1

if [ ! -e "$HOME/.local/share/ewe/VERSION" ]; then
    /usr/local/bin/ewe-live-deploy || exec agreety --cmd bash   # never a black screen
fi
exec "$HOME/.local/share/ewe/dotfiles/hypr/start-hyprland.sh"
